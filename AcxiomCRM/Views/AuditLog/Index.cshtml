@model List<AcxiomCRM.Models.AuditLog>
@{ ViewData["Title"] = "Audit Logs"; }

<div class="page-header">
    <div>
        <h4><i class="bi bi-shield-check me-2"></i>Audit Logs</h4>
        <span class="text-muted small">Security and activity audit trail</span>
    </div>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small">User</label>
                <input type="text" name="user" value="@ViewBag.User" class="form-control" placeholder="Search by user..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small">Action</label>
                <select name="action" class="form-select">
                    <option value="">All Actions</option>
                    @foreach (var action in ViewBag.Actions)
                    {
                        <option value="@action" selected="@(ViewBag.Action == action)">@action</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">Entity</label>
                <select name="entity" class="form-select">
                    <option value="">All Entities</option>
                    @foreach (var entity in ViewBag.Entities)
                    {
                        <option value="@entity" selected="@(ViewBag.Entity == entity)">@entity</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">From Date</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">To Date</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control" />
            </div>
            <div class="col-md-1">
                <label class="form-label small">&nbsp;</label>
                <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-search"></i></button>
            </div>
        </form>
    </div>
</div>

<!-- Audit Logs Table -->
<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                Showing latest <strong>@Model.Count</strong> audit entries (max 500 per query)
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Record ID</th>
                            <th>Old Value</th>
                            <th>New Value</th>
                            <th>Result</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="text-nowrap">
                                    <small>@log.CreatedDate.ToString("dd MMM yyyy")</small><br />
                                    <small class="text-muted">@log.CreatedDate.ToString("HH:mm:ss")</small>
                                </td>
                                <td>
                                    <strong>@(log.UserName ?? "System")</strong><br />
                                    <small class="text-muted">@log.UserId</small>
                                </td>
                                <td>
                                    @{
                                        var actionBadge = log.Action switch
                                        {
                                            "Login" => "badge bg-success",
                                            "Logout" => "badge bg-secondary",
                                            "FailedLogin" => "badge bg-danger",
                                            "Lockout" => "badge bg-danger",
                                            "Register" => "badge bg-info",
                                            "Create" => "badge bg-primary",
                                            "Update" => "badge bg-warning text-dark",
                                            "Delete" => "badge bg-danger",
                                            "Convert" => "badge bg-success",
                                            "RoleChange" => "badge bg-warning text-dark",
                                            "PasswordChange" => "badge bg-warning text-dark",
                                            "Unlock" => "badge bg-success",
                                            _ => "badge bg-secondary"
                                        };
                                    }
                                    <span class="@actionBadge">@log.Action</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark">@log.EntityName</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(log.RecordId))
                                    {
                                        <code class="small">@log.RecordId</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(log.OldValue))
                                    {
                                        <small class="text-muted">@(log.OldValue.Length > 30 ? log.OldValue.Substring(0, 30) + "..." : log.OldValue)</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(log.NewValue))
                                    {
                                        <small>@(log.NewValue.Length > 30 ? log.NewValue.Substring(0, 30) + "..." : log.NewValue)</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(log.Result))
                                    {
                                        @if (log.Result.Contains("Success", StringComparison.OrdinalIgnoreCase) || log.Result == "OK")
                                        {
                                            <span class="badge bg-success">@log.Result</span>
                                        }
                                        else if (log.Result.Contains("Failed", StringComparison.OrdinalIgnoreCase) || log.Result.Contains("Error", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger">@log.Result</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@log.Result</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(log.IpAddress))
                                    {
                                        <code class="small">@log.IpAddress</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3 p-3 bg-light rounded">
                <div class="row text-center">
                    <div class="col-md-3">
                        <h5 class="text-success">@Model.Count(a => a.Action == "Login")</h5>
                        <small class="text-muted">Logins</small>
                    </div>
                    <div class="col-md-3">
                        <h5 class="text-danger">@Model.Count(a => a.Action == "FailedLogin")</h5>
                        <small class="text-muted">Failed Logins</small>
                    </div>
                    <div class="col-md-3">
                        <h5 class="text-primary">@Model.Count(a => a.Action == "Create")</h5>
                        <small class="text-muted">Creates</small>
                    </div>
                    <div class="col-md-3">
                        <h5 class="text-warning">@Model.Count(a => a.Action == "Update")</h5>
                        <small class="text-muted">Updates</small>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-shield-check text-muted" style="font-size: 4rem;"></i>
                <p class="text-muted mt-3">No audit logs found for the selected filters.</p>
            </div>
        }
    </div>
</div>

<div class="alert alert-warning mt-3">
    <i class="bi bi-exclamation-triangle me-2"></i>
    <strong>Security Note:</strong> Audit logs are append-only and protected from modification. Keep audit data for compliance and security analysis.
</div>
