@model AcxiomCRM.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

<div class="page-header">
    <h4><i class="bi bi-speedometer2 me-2"></i>Dashboard</h4>
    <span class="text-muted small">Welcome back, <strong>@User.Identity!.Name</strong> &mdash; @DateTime.Now.ToString("dddd, dd MMM yyyy")</span>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#e8f4fd"><i class="bi bi-people-fill text-primary fs-4"></i></div>
                <div>
                    <div class="fs-2 fw-bold text-primary">@Model.TotalCustomers</div>
                    <div class="text-muted small">Total Customers</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#fff3e0"><i class="bi bi-funnel-fill text-warning fs-4"></i></div>
                <div>
                    <div class="fs-2 fw-bold text-warning">@Model.TotalLeads</div>
                    <div class="text-muted small">Total Leads <span class="badge bg-warning text-dark">@Model.OpenLeads open</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#e8f5e9"><i class="bi bi-trophy-fill text-success fs-4"></i></div>
                <div>
                    <div class="fs-2 fw-bold text-success">@Model.WonOpportunities</div>
                    <div class="text-muted small">Won <span class="badge bg-secondary">@Model.OpenOpportunities open</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#fce4ec"><i class="bi bi-currency-rupee text-danger fs-4"></i></div>
                <div>
                    <div class="fs-2 fw-bold text-danger">₹@Model.TotalPipelineValue.ToString("N0")</div>
                    <div class="text-muted small">Pipeline Value</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#f3e5f5"><i class="bi bi-calendar-check-fill text-purple fs-4" style="color:#7b1fa2"></i></div>
                <div>
                    <div class="fs-2 fw-bold" style="color:#7b1fa2">@Model.PendingFollowUps</div>
                    <div class="text-muted small">Pending Follow-Ups <span class="badge bg-danger">@Model.OverdueFollowUps overdue</span></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#e0f2f1"><i class="bi bi-graph-up-arrow text-teal fs-4" style="color:#00796b"></i></div>
                <div>
                    <div class="fs-2 fw-bold" style="color:#00796b">@Model.TotalOpportunities</div>
                    <div class="text-muted small">Total Opportunities</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#fff8e1"><i class="bi bi-x-circle-fill text-warning fs-4"></i></div>
                <div>
                    <div class="fs-2 fw-bold text-warning">@Model.LostOpportunities</div>
                    <div class="text-muted small">Lost Opportunities</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="kpi-icon" style="background:#e8eaf6"><i class="bi bi-bar-chart-fill text-indigo fs-4" style="color:#3949ab"></i></div>
                <div>
                    <div class="fs-2 fw-bold" style="color:#3949ab">@Model.OpenLeads</div>
                    <div class="text-muted small">Open Leads</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="row g-3">
    <div class="col-md-4">
        <div class="chart-card">
            <h6 class="fw-bold mb-3"><i class="bi bi-pie-chart me-2 text-warning"></i>Lead Status</h6>
            <canvas id="leadChart" height="220"></canvas>
        </div>
    </div>
    <div class="col-md-4">
        <div class="chart-card">
            <h6 class="fw-bold mb-3"><i class="bi bi-bar-chart me-2 text-primary"></i>Opportunity Pipeline</h6>
            <canvas id="pipelineChart" height="220"></canvas>
        </div>
    </div>
    <div class="col-md-4">
        <div class="chart-card">
            <h6 class="fw-bold mb-3"><i class="bi bi-graph-up me-2 text-success"></i>Monthly Sales</h6>
            <canvas id="salesChart" height="220"></canvas>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Lead Status Doughnut
    const leadData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LeadStatusChart));
    new Chart(document.getElementById('leadChart'), {
        type: 'doughnut',
        data: {
            labels: Object.keys(leadData),
            datasets: [{ data: Object.values(leadData), backgroundColor: ['#3498db','#f39c12','#2ecc71','#e74c3c','#9b59b6','#1abc9c'] }]
        },
        options: { plugins: { legend: { position: 'bottom' } }, cutout: '60%' }
    });

    // Pipeline Bar
    const pipeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OpportunityStageChart));
    new Chart(document.getElementById('pipelineChart'), {
        type: 'bar',
        data: {
            labels: Object.keys(pipeData),
            datasets: [{ label: 'Amount (₹)', data: Object.values(pipeData), backgroundColor: '#1a3c5e', borderRadius: 6 }]
        },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });

    // Monthly Sales Line
    const salesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesChart));
    new Chart(document.getElementById('salesChart'), {
        type: 'line',
        data: {
            labels: Object.keys(salesData),
            datasets: [{ label: 'Sales (₹)', data: Object.values(salesData), borderColor: '#e8732a', backgroundColor: 'rgba(232,115,42,.1)', fill: true, tension: .4, pointRadius: 4 }]
        },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });
</script>
}
