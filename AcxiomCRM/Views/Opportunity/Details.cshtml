@model AcxiomCRM.Models.Opportunity
@{ ViewData["Title"] = "Opportunity Details"; }

<div class="page-header">
    <h4><i class="bi bi-trophy me-2"></i>Opportunity Details</h4>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <!-- Main Details Card -->
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">@Model.OpportunityName</h5>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="text-muted small">Customer</label>
                        <div class="fw-bold">
                            @if (Model.Customer != null)
                            {
                                <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.CustomerId">
                                    @Model.Customer.CustomerName
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Not linked</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small">Lead</label>
                        <div class="fw-bold">
                            @if (Model.Lead != null)
                            {
                                <a asp-controller="Lead" asp-action="Details" asp-route-id="@Model.LeadId">
                                    @Model.Lead.LeadName
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Not linked</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small">Stage</label>
                        <div>
                            @{
                                var stageBadge = Model.Stage switch
                                {
                                    "Qualification" => "badge bg-info fs-6",
                                    "Proposal" => "badge bg-primary fs-6",
                                    "Negotiation" => "badge bg-warning text-dark fs-6",
                                    "Won" => "badge bg-success fs-6",
                                    "Lost" => "badge bg-danger fs-6",
                                    _ => "badge bg-secondary fs-6"
                                };
                            }
                            <span class="@stageBadge">@Model.Stage</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small">Status</label>
                        <div>
                            @{
                                var statusBadge = Model.Status switch
                                {
                                    "Open" => "badge bg-primary fs-6",
                                    "Won" => "badge bg-success fs-6",
                                    "Lost" => "badge bg-danger fs-6",
                                    _ => "badge bg-secondary fs-6"
                                };
                            }
                            <span class="@statusBadge">@Model.Status</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small">Assigned To</label>
                        <div class="fw-bold">@(Model.AssignedUser?.FullName ?? "Unassigned")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Financial Details -->
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-currency-rupee me-2"></i>Financial Details</h6>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-4">
                        <label class="text-muted small">Amount</label>
                        <div class="fs-4 fw-bold text-primary">₹@Model.Amount.ToString("N2")</div>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small">Probability</label>
                        <div class="fs-4 fw-bold text-info">@Model.Probability%</div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-info" role="progressbar" style="width: @Model.Probability%"></div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small">Weighted Amount</label>
                        <div class="fs-4 fw-bold text-success">₹@Model.WeightedAmount.ToString("N2")</div>
                        <small class="text-muted">Amount × Probability ÷ 100</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Timeline & Dates -->
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-calendar me-2"></i>Timeline</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="text-muted small">Expected Close Date</label>
                        <div class="fw-bold">
                            @Model.ExpectedCloseDate.ToString("dd MMMM yyyy")
                            @if (Model.ExpectedCloseDate < DateTime.Today && Model.Status == "Open")
                            {
                                <span class="badge bg-danger ms-2">Overdue</span>
                            }
                            else if (Model.ExpectedCloseDate <= DateTime.Today.AddDays(7) && Model.Status == "Open")
                            {
                                <span class="badge bg-warning text-dark ms-2">Due Soon</span>
                            }
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small">Days Until Close</label>
                        <div class="fw-bold">
                            @{
                                var daysRemaining = (Model.ExpectedCloseDate - DateTime.Today).Days;
                                var daysText = daysRemaining > 0 ? $"{daysRemaining} days" : daysRemaining == 0 ? "Today" : $"{Math.Abs(daysRemaining)} days overdue";
                                var daysClass = daysRemaining > 7 ? "text-success" : daysRemaining >= 0 ? "text-warning" : "text-danger";
                            }
                            <span class="@daysClass">@daysText</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small">Created Date</label>
                        <div class="fw-bold">@Model.CreatedDate.ToString("dd MMM yyyy HH:mm")</div>
                    </div>

                    @if (Model.ModifiedDate.HasValue)
                    {
                        <div class="col-md-4">
                            <label class="text-muted small">Last Modified</label>
                            <div class="fw-bold">@Model.ModifiedDate.Value.ToString("dd MMM yyyy HH:mm")</div>
                        </div>
                    }

                    <div class="col-md-4">
                        <label class="text-muted small">Created By</label>
                        <div class="fw-bold">@(Model.CreatedBy ?? "System")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Notes -->
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-sticky me-2"></i>Notes</h6>
                </div>
                <div class="card-body">
                    <p class="mb-0">@Model.Notes</p>
                </div>
            </div>
        }
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Quick Actions -->
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0">Quick Actions</h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-outline-primary">
                        <i class="bi bi-pencil me-2"></i>Edit Opportunity
                    </a>
                    <a asp-controller="FollowUp" asp-action="Create" class="btn btn-outline-success">
                        <i class="bi bi-calendar-plus me-2"></i>Schedule Follow-Up
                    </a>
                    <a asp-controller="Activity" asp-action="Create" class="btn btn-outline-info">
                        <i class="bi bi-journal-plus me-2"></i>Log Activity
                    </a>
                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <form asp-action="Delete" asp-route-id="@Model.OpportunityId" method="post"
                              onsubmit="return confirm('Mark this opportunity as Lost?');">
                            <button type="submit" class="btn btn-outline-danger w-100">
                                <i class="bi bi-x-circle me-2"></i>Mark as Lost
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>

        <!-- Stage Progress -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Sales Pipeline Progress</h6>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-2">
                    @{
                        var stages = new[] { "Qualification", "Proposal", "Negotiation", "Won", "Lost" };
                        var currentIndex = Array.IndexOf(stages, Model.Stage);
                    }
                    @for (int i = 0; i < stages.Length - 2; i++)
                    {
                        var isActive = i <= currentIndex;
                        var isCurrent = i == currentIndex;
                        var circleClass = isCurrent ? "bg-primary" : isActive ? "bg-success" : "bg-light";
                        var textClass = isActive ? "fw-bold" : "text-muted";

                        <div class="d-flex align-items-center gap-2">
                            <div class="@circleClass rounded-circle d-flex align-items-center justify-content-center text-white" 
                                 style="width: 32px; height: 32px; min-width: 32px;">
                                @if (isActive)
                                {
                                    <i class="bi bi-check"></i>
                                }
                            </div>
                            <span class="@textClass">@stages[i]</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
