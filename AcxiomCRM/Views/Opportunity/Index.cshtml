@model List<AcxiomCRM.Models.Opportunity>
@{ ViewData["Title"] = "Opportunities"; }

<div class="page-header">
    <div>
        <h4><i class="bi bi-trophy me-2"></i>Opportunities</h4>
        <span class="text-muted small">Manage sales opportunities and pipeline</span>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>New Opportunity</a>
</div>

<!-- Search & Filter -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or customer..." />
            </div>
            <div class="col-md-3">
                <select name="stage" class="form-select">
                    <option value="">All Stages</option>
                    <option value="Qualification" selected="@(ViewBag.Stage == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(ViewBag.Stage == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(ViewBag.Stage == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(ViewBag.Stage == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.Stage == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Open" selected="@(ViewBag.Status == "Open")">Open</option>
                    <option value="Won" selected="@(ViewBag.Status == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.Status == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-search me-1"></i>Search</button>
            </div>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Opportunities Table -->
<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Opportunity</th>
                            <th>Customer</th>
                            <th>Stage</th>
                            <th>Amount</th>
                            <th>Probability</th>
                            <th>Weighted</th>
                            <th>Close Date</th>
                            <th>Status</th>
                            <th>Owner</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var opp in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@opp.OpportunityName</strong>
                                    @if (opp.ExpectedCloseDate < DateTime.Today && opp.Status == "Open")
                                    {
                                        <span class="badge bg-danger ms-1">Overdue</span>
                                    }
                                </td>
                                <td>@(opp.Customer?.CustomerName ?? "N/A")</td>
                                <td>
                                    @{
                                        var stageBadge = opp.Stage switch
                                        {
                                            "Qualification" => "badge bg-info",
                                            "Proposal" => "badge bg-primary",
                                            "Negotiation" => "badge bg-warning text-dark",
                                            "Won" => "badge bg-success",
                                            "Lost" => "badge bg-danger",
                                            _ => "badge bg-secondary"
                                        };
                                    }
                                    <span class="@stageBadge">@opp.Stage</span>
                                </td>
                                <td class="text-end">₹@opp.Amount.ToString("N0")</td>
                                <td class="text-center">@opp.Probability%</td>
                                <td class="text-end fw-bold">₹@opp.WeightedAmount.ToString("N0")</td>
                                <td>
                                    <small>@opp.ExpectedCloseDate.ToString("dd MMM yyyy")</small>
                                </td>
                                <td>
                                    @{
                                        var statusBadge = opp.Status switch
                                        {
                                            "Open" => "badge bg-primary",
                                            "Won" => "badge bg-success",
                                            "Lost" => "badge bg-danger",
                                            _ => "badge bg-secondary"
                                        };
                                    }
                                    <span class="@statusBadge">@opp.Status</span>
                                </td>
                                <td><small>@(opp.AssignedUser?.FullName ?? "Unassigned")</small></td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="btn btn-sm btn-outline-primary" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@opp.OpportunityId" class="btn btn-sm btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@opp.OpportunityId" method="post" class="d-inline"
                                              onsubmit="return confirm('Mark this opportunity as Lost?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Mark Lost">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3 p-3 bg-light rounded">
                <div class="row text-center">
                    <div class="col-md-3">
                        <h5 class="text-primary">@Model.Count(o => o.Status == "Open")</h5>
                        <small class="text-muted">Open Opportunities</small>
                    </div>
                    <div class="col-md-3">
                        <h5 class="text-success">₹@Model.Where(o => o.Status == "Open").Sum(o => o.Amount).ToString("N0")</h5>
                        <small class="text-muted">Total Pipeline</small>
                    </div>
                    <div class="col-md-3">
                        <h5 class="text-info">₹@Model.Where(o => o.Status == "Open").Sum(o => o.WeightedAmount).ToString("N0")</h5>
                        <small class="text-muted">Weighted Pipeline</small>
                    </div>
                    <div class="col-md-3">
                        <h5 class="text-warning">@Model.Count(o => o.Status == "Won")</h5>
                        <small class="text-muted">Won</small>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-trophy text-muted" style="font-size: 4rem;"></i>
                <p class="text-muted mt-3">No opportunities found. Create your first opportunity!</p>
                <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Create Opportunity</a>
            </div>
        }
    </div>
</div>
