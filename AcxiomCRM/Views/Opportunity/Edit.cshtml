@model AcxiomCRM.Models.Opportunity
@{ ViewData["Title"] = "Edit Opportunity"; }

<div class="page-header">
    <h4><i class="bi bi-pencil me-2"></i>Edit Opportunity</h4>
    <div class="d-flex gap-2">
        <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-outline-info"><i class="bi bi-eye me-1"></i>View Details</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="OpportunityId" />
                    
                    <div class="row g-3">
                        <!-- Opportunity Name -->
                        <div class="col-md-6">
                            <label asp-for="OpportunityName" class="form-label required">Opportunity Name</label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <!-- Customer -->
                        <div class="col-md-6">
                            <label for="CustomerId" class="form-label">Customer</label>
                            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                                <option value="">-- Select Customer (Optional) --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <!-- Lead -->
                        <div class="col-md-6">
                            <label for="LeadId" class="form-label">Lead</label>
                            <select asp-for="LeadId" class="form-select" asp-items="ViewBag.Leads">
                                <option value="">-- Select Lead (Optional) --</option>
                            </select>
                            <span asp-validation-for="LeadId" class="text-danger small"></span>
                        </div>

                        <!-- Assigned To -->
                        <div class="col-md-6">
                            <label for="AssignedTo" class="form-label">Assign To</label>
                            <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.Users">
                                <option value="">-- Select Sales Executive --</option>
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>

                        <!-- Stage -->
                        <div class="col-md-3">
                            <label asp-for="Stage" class="form-label required">Stage</label>
                            <select asp-for="Stage" class="form-select" asp-items="ViewBag.Stages"></select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>

                        <!-- Status -->
                        <div class="col-md-3">
                            <label asp-for="Status" class="form-label required">Status</label>
                            <select asp-for="Status" class="form-select" asp-items="ViewBag.Statuses"></select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <!-- Amount -->
                        <div class="col-md-3">
                            <label asp-for="Amount" class="form-label required">Amount (₹)</label>
                            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
                            <span asp-validation-for="Amount" class="text-danger small"></span>
                        </div>

                        <!-- Probability -->
                        <div class="col-md-3">
                            <label asp-for="Probability" class="form-label required">Probability (%)</label>
                            <input asp-for="Probability" type="number" min="0" max="100" class="form-control" />
                            <span asp-validation-for="Probability" class="text-danger small"></span>
                        </div>

                        <!-- Expected Close Date -->
                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label required">Expected Close Date</label>
                            <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small"></span>
                            <small class="text-muted">Cannot be in the past for open opportunities</small>
                        </div>

                        <!-- Weighted Amount Display -->
                        <div class="col-md-6">
                            <label class="form-label">Weighted Amount</label>
                            <div class="form-control bg-light">₹<span id="weightedAmount">0</span></div>
                            <small class="text-muted">Amount × Probability ÷ 100</small>
                        </div>

                        <!-- Notes -->
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label">Notes</label>
                            <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <!-- Actions -->
                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i>Update Opportunity
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Opportunity Info</h6>
                <div class="small">
                    <div class="mb-2">
                        <strong>Created:</strong> @Model.CreatedDate.ToString("dd MMM yyyy HH:mm")
                    </div>
                    @if (Model.ModifiedDate.HasValue)
                    {
                        <div class="mb-2">
                            <strong>Modified:</strong> @Model.ModifiedDate.Value.ToString("dd MMM yyyy HH:mm")
                        </div>
                    }
                    <div class="mb-2">
                        <strong>Created By:</strong> @(Model.CreatedBy ?? "System")
                    </div>
                </div>
            </div>
        </div>

        <div class="card bg-light mt-3">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-exclamation-triangle me-2"></i>Validation Rules</h6>
                <ul class="small mb-0">
                    <li class="mb-2">Amount must be greater than 0</li>
                    <li class="mb-2">Probability must be 0-100%</li>
                    <li class="mb-2">Expected Close Date cannot be in the past for open opportunities</li>
                    <li class="mb-2">Status transitions should follow business logic</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Calculate weighted amount dynamically
        function updateWeighted() {
            const amount = parseFloat($('#Amount').val()) || 0;
            const probability = parseFloat($('#Probability').val()) || 0;
            const weighted = (amount * probability / 100).toFixed(2);
            $('#weightedAmount').text(weighted.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ","));
        }
        
        $('#Amount, #Probability').on('input', updateWeighted);
        $(document).ready(updateWeighted);
    </script>
}
