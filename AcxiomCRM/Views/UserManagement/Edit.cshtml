@model AcxiomCRM.ViewModels.UserEditViewModel
@{ ViewData["Title"] = "Edit User"; }

<div class="page-header">
    <h4><i class="bi bi-person-gear me-2"></i>Edit User</h4>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="row g-3">
                        <!-- Full Name -->
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label required">Full Name</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label required">Email</label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Role -->
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label required">Role</label>
                            <select asp-for="Role" class="form-select">
                                <option value="">-- Select Role --</option>
                                <option value="Admin">Admin</option>
                                <option value="Manager">Manager</option>
                                <option value="SalesExecutive">Sales Executive</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <!-- Is Active -->
                        <div class="col-md-6">
                            <label class="form-label">Account Status</label>
                            <div class="form-check form-switch mt-2">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                                <label asp-for="IsActive" class="form-check-label">Active</label>
                            </div>
                            <small class="text-muted">Inactive users cannot log in</small>
                        </div>

                        <!-- Actions -->
                        <div class="col-12 d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i>Update User
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card bg-light">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Role Descriptions</h6>
                <ul class="small mb-0">
                    <li class="mb-2"><strong>Admin:</strong> Full system access, user management, audit logs, all reports</li>
                    <li class="mb-2"><strong>Manager:</strong> Team management, pipeline visibility, management reports</li>
                    <li class="mb-2"><strong>Sales Executive:</strong> Manage assigned customers, leads, opportunities, and follow-ups</li>
                </ul>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Additional Actions</h6>
                <div class="d-grid gap-2">
                    <a asp-action="ResetPassword" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                        <i class="bi bi-key me-2"></i>Reset Password
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
