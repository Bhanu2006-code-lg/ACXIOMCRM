@model AcxiomCRM.ViewModels.ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; }

<div class="page-header">
    <h4><i class="bi bi-key me-2"></i>Reset User Password</h4>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    <strong>Warning:</strong> You are about to reset this user's password. They will need to use the new password to log in.
                </div>

                <form asp-action="ResetPassword" method="post">
                    <input type="hidden" asp-for="UserId" />
                    
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label required">New Password</label>
                        <input asp-for="NewPassword" type="password" class="form-control" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <small class="text-muted">Minimum 8 characters, must include uppercase, lowercase, digit, and special character</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label required">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle me-1"></i>Reset Password
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="card mt-3 bg-light">
            <div class="card-body">
                <h6 class="fw-bold mb-3"><i class="bi bi-shield-check me-2"></i>Password Requirements</h6>
                <ul class="small mb-0">
                    <li class="mb-2">At least 8 characters long</li>
                    <li class="mb-2">Contains at least one uppercase letter (A-Z)</li>
                    <li class="mb-2">Contains at least one lowercase letter (a-z)</li>
                    <li class="mb-2">Contains at least one digit (0-9)</li>
                    <li class="mb-2">Contains at least one special character (!@@#$%^&amp;* etc.)</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
