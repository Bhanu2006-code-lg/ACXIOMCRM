@model List<AcxiomCRM.Models.AuditLog>
@{ ViewData["Title"] = "Audit Report"; }

<div class="page-header">
    <div>
        <h4><i class="bi bi-shield-check me-2"></i>Audit Report</h4>
        <span class="text-muted small">Security and business activity audit trail</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Reports</a>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small">Action</label>
                <select name="action" class="form-select">
                    <option value="">All Actions</option>
                    <option value="Login">Login</option>
                    <option value="Logout">Logout</option>
                    <option value="FailedLogin">Failed Login</option>
                    <option value="Create">Create</option>
                    <option value="Update">Update</option>
                    <option value="Delete">Delete</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Entity</label>
                <select name="entity" class="form-select">
                    <option value="">All Entities</option>
                    <option value="Auth">Auth</option>
                    <option value="Customer">Customer</option>
                    <option value="Lead">Lead</option>
                    <option value="Opportunity">Opportunity</option>
                    <option value="FollowUp">FollowUp</option>
                    <option value="User">User</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">From Date</label>
                <input type="date" name="from" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">To Date</label>
                <input type="date" name="to" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small">&nbsp;</label>
                <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-filter"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Report Table -->
<div class="card">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                Showing latest <strong>@Model.Count</strong> audit entries (limited to 500)
            </div>

            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>Record</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td class="text-nowrap">
                                    <small>@log.CreatedDate.ToString("dd MMM yyyy HH:mm:ss")</small>
                                </td>
                                <td><small><strong>@(log.UserName ?? "System")</strong></small></td>
                                <td>
                                    @{
                                        var actionBadge = log.Action switch
                                        {
                                            "Login" => "badge bg-success",
                                            "Logout" => "badge bg-secondary",
                                            "FailedLogin" => "badge bg-danger",
                                            "Create" => "badge bg-primary",
                                            "Update" => "badge bg-warning text-dark",
                                            "Delete" => "badge bg-danger",
                                            _ => "badge bg-secondary"
                                        };
                                    }
                                    <span class="@actionBadge">@log.Action</span>
                                </td>
                                <td><span class="badge bg-light text-dark">@log.EntityName</span></td>
                                <td><small>@(log.RecordId ?? "-")</small></td>
                                <td>
                                    <small class="text-muted">
                                        @if (!string.IsNullOrEmpty(log.OldValue) && !string.IsNullOrEmpty(log.NewValue))
                                        {
                                            <span>@log.OldValue → @log.NewValue</span>
                                        }
                                        else if (!string.IsNullOrEmpty(log.NewValue))
                                        {
                                            <span>@log.NewValue</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3 p-3 bg-light rounded">
                <div class="row text-center">
                    <div class="col-md-3">
                        <h5 class="text-success">@Model.Count(a => a.Action == "Login")</h5>
                        <small class="text-muted">Logins</small>
                    </div>
                    <div class="col-md-3">
                        <h5 class="text-primary">@Model.Count(a => a.Action == "Create")</h5>
                        <small class="text-muted">Creates</small>
                    </div>
                    <div class="col-md-3">
                        <h5 class="text-warning">@Model.Count(a => a.Action == "Update")</h5>
                        <small class="text-muted">Updates</small>
                    </div>
                    <div class="col-md-3">
                        <h5 class="text-danger">@Model.Count(a => a.Action == "Delete" || a.Action == "FailedLogin")</h5>
                        <small class="text-muted">Deletes/Failures</small>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-shield-check text-muted" style="font-size: 4rem;"></i>
                <p class="text-muted mt-3">No audit data found for the selected criteria.</p>
            </div>
        }
    </div>
</div>
