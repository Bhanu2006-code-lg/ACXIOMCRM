@model List<AcxiomCRM.Models.Opportunity>
@{ ViewData["Title"] = "Opportunity Report"; }

<div class="page-header">
    <div>
        <h4><i class="bi bi-trophy me-2"></i>Opportunity Report</h4>
        <span class="text-muted small">Opportunities by stage, amount, and close date</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Reports</a>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <label class="form-label small">Stage</label>
                <select name="stage" class="form-select">
                    <option value="">All Stages</option>
                    <option value="Qualification" selected="@(ViewBag.Stage == "Qualification")">Qualification</option>
                    <option value="Proposal" selected="@(ViewBag.Stage == "Proposal")">Proposal</option>
                    <option value="Negotiation" selected="@(ViewBag.Stage == "Negotiation")">Negotiation</option>
                    <option value="Won" selected="@(ViewBag.Stage == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.Stage == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label small">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Open" selected="@(ViewBag.Status == "Open")">Open</option>
                    <option value="Won" selected="@(ViewBag.Status == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.Status == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-12">
                <button type="submit" class="btn btn-secondary"><i class="bi bi-filter me-1"></i>Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Report Table -->
<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Opportunity Name</th>
                            <th>Customer</th>
                            <th>Stage</th>
                            <th>Amount</th>
                            <th>Probability</th>
                            <th>Weighted Amount</th>
                            <th>Expected Close</th>
                            <th>Status</th>
                            <th>Owner</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var opp in Model)
                        {
                            <tr>
                                <td><strong>@opp.OpportunityName</strong></td>
                                <td>@(opp.Customer?.CustomerName ?? "N/A")</td>
                                <td>
                                    @{
                                        var stageBadge = opp.Stage switch
                                        {
                                            "Qualification" => "badge bg-info",
                                            "Proposal" => "badge bg-primary",
                                            "Negotiation" => "badge bg-warning text-dark",
                                            "Won" => "badge bg-success",
                                            "Lost" => "badge bg-danger",
                                            _ => "badge bg-secondary"
                                        };
                                    }
                                    <span class="@stageBadge">@opp.Stage</span>
                                </td>
                                <td class="text-end"><strong>₹@opp.Amount.ToString("N0")</strong></td>
                                <td class="text-center">@opp.Probability%</td>
                                <td class="text-end text-success"><strong>₹@opp.WeightedAmount.ToString("N0")</strong></td>
                                <td><small>@opp.ExpectedCloseDate.ToString("dd MMM yyyy")</small></td>
                                <td>
                                    @{
                                        var statusBadge = opp.Status switch
                                        {
                                            "Open" => "badge bg-primary",
                                            "Won" => "badge bg-success",
                                            "Lost" => "badge bg-danger",
                                            _ => "badge bg-secondary"
                                        };
                                    }
                                    <span class="@statusBadge">@opp.Status</span>
                                </td>
                                <td><small>@(opp.AssignedUser?.FullName ?? "Unassigned")</small></td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end"><strong>Totals:</strong></td>
                            <td class="text-end"><strong>₹@Model.Sum(o => o.Amount).ToString("N0")</strong></td>
                            <td class="text-center">-</td>
                            <td class="text-end text-success"><strong>₹@Model.Sum(o => o.WeightedAmount).ToString("N0")</strong></td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="mt-3 p-3 bg-light rounded">
                <div class="row text-center">
                    <div class="col-md-2">
                        <h5 class="text-primary">@Model.Count</h5>
                        <small class="text-muted">Total Opportunities</small>
                    </div>
                    <div class="col-md-2">
                        <h5 class="text-info">@Model.Count(o => o.Status == "Open")</h5>
                        <small class="text-muted">Open</small>
                    </div>
                    <div class="col-md-2">
                        <h5 class="text-success">@Model.Count(o => o.Status == "Won")</h5>
                        <small class="text-muted">Won</small>
                    </div>
                    <div class="col-md-2">
                        <h5 class="text-danger">@Model.Count(o => o.Status == "Lost")</h5>
                        <small class="text-muted">Lost</small>
                    </div>
                    <div class="col-md-2">
                        <h5 class="text-primary">₹@Model.Sum(o => o.Amount).ToString("N0")</h5>
                        <small class="text-muted">Total Amount</small>
                    </div>
                    <div class="col-md-2">
                        <h5 class="text-success">₹@Model.Sum(o => o.WeightedAmount).ToString("N0")</h5>
                        <small class="text-muted">Weighted Amount</small>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted">No opportunities found for the selected criteria.</p>
            </div>
        }
    </div>
</div>
