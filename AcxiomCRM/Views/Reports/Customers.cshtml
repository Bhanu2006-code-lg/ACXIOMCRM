@model List<AcxiomCRM.Models.Customer>
@{ ViewData["Title"] = "Customer Report"; }

<div class="page-header">
    <div>
        <h4><i class="bi bi-people me-2"></i>Customer Report</h4>
        <span class="text-muted small">Customer list with status and ownership details</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Reports</a>
</div>

<!-- Filters -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">From Date</label>
                <input type="date" name="from" value="@ViewBag.From" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">To Date</label>
                <input type="date" name="to" value="@ViewBag.To" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label small">&nbsp;</label>
                <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-filter me-1"></i>Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Report Table -->
<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Customer Code</th>
                            <th>Customer Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Company</th>
                            <th>City</th>
                            <th>Status</th>
                            <th>Owner</th>
                            <th>Created Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in Model)
                        {
                            <tr>
                                <td><code>@customer.CustomerCode</code></td>
                                <td><strong>@customer.CustomerName</strong></td>
                                <td><small>@customer.Email</small></td>
                                <td><small>@customer.Phone</small></td>
                                <td>@(customer.CompanyName ?? "-")</td>
                                <td>@(customer.City ?? "-")</td>
                                <td>
                                    @if (customer.Status == "Active")
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td><small>@(customer.AssignedUser?.FullName ?? "Unassigned")</small></td>
                                <td><small>@customer.CreatedDate.ToString("dd MMM yyyy")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3 p-3 bg-light rounded">
                <div class="row text-center">
                    <div class="col-md-3">
                        <h5 class="text-primary">@Model.Count</h5>
                        <small class="text-muted">Total Customers</small>
                    </div>
                    <div class="col-md-3">
                        <h5 class="text-success">@Model.Count(c => c.Status == "Active")</h5>
                        <small class="text-muted">Active</small>
                    </div>
                    <div class="col-md-3">
                        <h5 class="text-secondary">@Model.Count(c => c.Status == "Inactive")</h5>
                        <small class="text-muted">Inactive</small>
                    </div>
                    <div class="col-md-3">
                        <h5 class="text-info">@Model.GroupBy(c => c.AssignedUser).Count()</h5>
                        <small class="text-muted">Unique Owners</small>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted">No customers found for the selected criteria.</p>
            </div>
        }
    </div>
</div>
