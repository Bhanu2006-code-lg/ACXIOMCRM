@model List<AcxiomCRM.Models.FollowUp>
@{ ViewData["Title"] = "Follow-Up Report"; }

<div class="page-header">
    <div>
        <h4><i class="bi bi-calendar-check me-2"></i>Follow-Up Report</h4>
        <span class="text-muted small">Track planned, completed, and overdue follow-ups</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to Reports</a>
</div>

<!-- Alert -->
@if (ViewBag.OverdueCount > 0)
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>@ViewBag.OverdueCount overdue follow-up(s)</strong> need immediate attention!
    </div>
}

<!-- Filter -->
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-6">
                <label class="form-label small">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Status</option>
                    <option value="Planned" selected="@(ViewBag.Status == "Planned")">Planned</option>
                    <option value="Completed" selected="@(ViewBag.Status == "Completed")">Completed</option>
                    <option value="Missed" selected="@(ViewBag.Status == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label small">&nbsp;</label>
                <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-filter me-1"></i>Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Report Table -->
<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th>Subject</th>
                            <th>Type</th>
                            <th>Related To</th>
                            <th>Owner</th>
                            <th>Status</th>
                            <th>Days</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fu in Model)
                        {
                            var isOverdue = fu.Status == "Planned" && fu.FollowUpDate < DateTime.Today;
                            var rowClass = isOverdue ? "table-danger" : "";
                            var daysFromNow = (fu.FollowUpDate - DateTime.Today).Days;

                            <tr class="@rowClass">
                                <td>
                                    <strong>@fu.FollowUpDate.ToString("dd MMM yyyy")</strong>
                                    @if (isOverdue)
                                    {
                                        <br /><span class="badge bg-danger">Overdue</span>
                                    }
                                </td>
                                <td><strong>@fu.Subject</strong></td>
                                <td>
                                    @{
                                        var typeIcon = fu.FollowUpType switch
                                        {
                                            "Call" => "bi-telephone text-primary",
                                            "Email" => "bi-envelope text-info",
                                            "Meeting" => "bi-people text-success",
                                            "Visit" => "bi-geo-alt text-warning",
                                            _ => "bi-calendar text-secondary"
                                        };
                                    }
                                    <i class="bi @typeIcon me-1"></i>@fu.FollowUpType
                                </td>
                                <td>
                                    @if (fu.Customer != null)
                                    {
                                        <i class="bi bi-person me-1"></i>@fu.Customer.CustomerName
                                    }
                                    else if (fu.Lead != null)
                                    {
                                        <i class="bi bi-funnel me-1"></i>@fu.Lead.LeadName
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td><small>@(fu.AssignedUser?.FullName ?? "Unassigned")</small></td>
                                <td>
                                    @{
                                        var statusBadge = fu.Status switch
                                        {
                                            "Planned" => "badge bg-primary",
                                            "Completed" => "badge bg-success",
                                            "Missed" => "badge bg-danger",
                                            "Cancelled" => "badge bg-secondary",
                                            _ => "badge bg-secondary"
                                        };
                                    }
                                    <span class="@statusBadge">@fu.Status</span>
                                </td>
                                <td>
                                    @if (fu.Status == "Planned")
                                    {
                                        if (daysFromNow < 0)
                                        {
                                            <span class="text-danger fw-bold">@Math.Abs(daysFromNow) days ago</span>
                                        }
                                        else if (daysFromNow == 0)
                                        {
                                            <span class="text-warning fw-bold">Today</span>
                                        }
                                        else
                                        {
                                            <span class="text-success">In @daysFromNow days</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3 p-3 bg-light rounded">
                <div class="row text-center">
                    <div class="col-md-3">
                        <h5 class="text-primary">@Model.Count(f => f.Status == "Planned")</h5>
                        <small class="text-muted">Planned</small>
                    </div>
                    <div class="col-md-3">
                        <h5 class="text-success">@Model.Count(f => f.Status == "Completed")</h5>
                        <small class="text-muted">Completed</small>
                    </div>
                    <div class="col-md-3">
                        <h5 class="text-danger">@Model.Count(f => f.Status == "Planned" && f.FollowUpDate < DateTime.Today)</h5>
                        <small class="text-muted">Overdue</small>
                    </div>
                    <div class="col-md-3">
                        <h5 class="text-warning">@Model.Count(f => f.Status == "Missed")</h5>
                        <small class="text-muted">Missed</small>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <p class="text-muted">No follow-ups found for the selected criteria.</p>
            </div>
        }
    </div>
</div>
