@model AcxiomCRM.Models.Lead
@{ ViewData["Title"] = "Lead Details"; }

<div class="page-header">
    <h4><i class="bi bi-funnel me-2"></i>Lead Details</h4>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to List</a>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <!-- Main Details Card -->
        <div class="card mb-3">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">@Model.LeadName</h5>
                <small>Lead Code: @Model.LeadCode</small>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="text-muted small">Email</label>
                        <div class="fw-bold"><i class="bi bi-envelope me-2"></i><a href="mailto:@Model.Email">@Model.Email</a></div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small">Phone</label>
                        <div class="fw-bold"><i class="bi bi-telephone me-2"></i><a href="tel:@Model.Phone">@Model.Phone</a></div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
                    {
                        <div class="col-md-6">
                            <label class="text-muted small">Company</label>
                            <div class="fw-bold"><i class="bi bi-building me-2"></i>@Model.CompanyName</div>
                        </div>
                    }

                    <div class="col-md-6">
                        <label class="text-muted small">Source</label>
                        <div class="fw-bold"><i class="bi bi-arrow-down-circle me-2"></i>@Model.Source</div>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small">Status</label>
                        <div>
                            @{
                                var statusBadge = Model.Status switch
                                {
                                    "New" => "badge bg-info fs-6",
                                    "Contacted" => "badge bg-primary fs-6",
                                    "Qualified" => "badge bg-success fs-6",
                                    "Unqualified" => "badge bg-secondary fs-6",
                                    "Converted" => "badge bg-success fs-6",
                                    "Lost" => "badge bg-danger fs-6",
                                    _ => "badge bg-secondary fs-6"
                                };
                            }
                            <span class="@statusBadge">@Model.Status</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small">Priority</label>
                        <div>
                            @{
                                var priorityBadge = Model.Priority switch
                                {
                                    "High" => "badge bg-danger fs-6",
                                    "Medium" => "badge bg-warning text-dark fs-6",
                                    "Low" => "badge bg-secondary fs-6",
                                    _ => "badge bg-secondary fs-6"
                                };
                            }
                            <span class="@priorityBadge">@Model.Priority</span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small">Assigned To</label>
                        <div class="fw-bold"><i class="bi bi-person me-2"></i>@(Model.AssignedUser?.FullName ?? "Unassigned")</div>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small">Expected Value</label>
                        <div class="fs-5 fw-bold text-success">₹@Model.ExpectedValue.ToString("N2")</div>
                    </div>

                    @if (Model.IsConverted && Model.ConvertedCustomer != null)
                    {
                        <div class="col-md-6">
                            <label class="text-muted small">Converted To</label>
                            <div class="fw-bold">
                                <a asp-controller="Customer" asp-action="Details" asp-route-id="@Model.ConvertedCustomerId" class="btn btn-sm btn-success">
                                    <i class="bi bi-check-circle me-1"></i>View Customer: @Model.ConvertedCustomer.CustomerName
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Timeline -->
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0"><i class="bi bi-calendar me-2"></i>Timeline</h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="text-muted small">Created Date</label>
                        <div class="fw-bold">@Model.CreatedDate.ToString("dd MMMM yyyy HH:mm")</div>
                    </div>

                    @if (Model.ModifiedDate.HasValue)
                    {
                        <div class="col-md-4">
                            <label class="text-muted small">Last Modified</label>
                            <div class="fw-bold">@Model.ModifiedDate.Value.ToString("dd MMMM yyyy HH:mm")</div>
                        </div>
                    }

                    <div class="col-md-4">
                        <label class="text-muted small">Created By</label>
                        <div class="fw-bold">@(Model.CreatedBy ?? "System")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Notes -->
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="bi bi-sticky me-2"></i>Notes</h6>
                </div>
                <div class="card-body">
                    <p class="mb-0">@Model.Notes</p>
                </div>
            </div>
        }
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- Quick Actions -->
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0">Quick Actions</h6>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-primary">
                        <i class="bi bi-pencil me-2"></i>Edit Lead
                    </a>
                    <a asp-controller="FollowUp" asp-action="Create" class="btn btn-outline-success">
                        <i class="bi bi-calendar-plus me-2"></i>Schedule Follow-Up
                    </a>
                    <a asp-controller="Activity" asp-action="Create" class="btn btn-outline-info">
                        <i class="bi bi-journal-plus me-2"></i>Log Activity
                    </a>
                    @if (!Model.IsConverted && Model.Status == "Qualified")
                    {
                        <a href="#" class="btn btn-outline-success" onclick="alert('Lead conversion feature - Create customer and opportunity from this lead'); return false;">
                            <i class="bi bi-arrow-right-circle me-2"></i>Convert to Customer
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Lead Progress -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">Lead Progress</h6>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-2">
                    @{
                        var statuses = new[] { "New", "Contacted", "Qualified" };
                        var currentIndex = Array.IndexOf(statuses, Model.Status);
                        if (currentIndex == -1 && Model.IsConverted) currentIndex = 3;
                    }
                    @for (int i = 0; i < statuses.Length; i++)
                    {
                        var isActive = i <= currentIndex;
                        var isCurrent = i == currentIndex;
                        var circleClass = isCurrent ? "bg-warning" : isActive ? "bg-success" : "bg-light";
                        var textClass = isActive ? "fw-bold" : "text-muted";

                        <div class="d-flex align-items-center gap-2">
                            <div class="@circleClass rounded-circle d-flex align-items-center justify-content-center text-white" 
                                 style="width: 32px; height: 32px; min-width: 32px;">
                                @if (isActive)
                                {
                                    <i class="bi bi-check"></i>
                                }
                            </div>
                            <span class="@textClass">@statuses[i]</span>
                        </div>
                    }
                    @if (Model.IsConverted)
                    {
                        <div class="d-flex align-items-center gap-2">
                            <div class="bg-success rounded-circle d-flex align-items-center justify-content-center text-white" 
                                 style="width: 32px; height: 32px; min-width: 32px;">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <span class="fw-bold text-success">Converted</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
