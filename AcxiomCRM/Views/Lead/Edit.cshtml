@model AcxiomCRM.Models.Lead
@{ ViewData["Title"] = "Edit Lead"; }

<div class="page-header">
    <h4><i class="bi bi-pencil me-2"></i>Edit Lead</h4>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="crm-form-card" style="max-width:700px">
    <form asp-action="Edit" asp-route-id="@Model.LeadId" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="LeadName" class="form-label">Lead Name <span class="text-danger">*</span></label>
                <input asp-for="LeadName" class="form-control" />
                <span asp-validation-for="LeadName" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CompanyName" class="form-label">Company</label>
                <input asp-for="CompanyName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label">Phone <span class="text-danger">*</span></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Source" class="form-label">Source</label>
                <select asp-for="Source" asp-items="ViewBag.Sources" class="form-select"></select>
            </div>
            <div class="col-md-6">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" asp-items="ViewBag.Statuses" class="form-select"></select>
                <span asp-validation-for="Status" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Priority" class="form-label">Priority</label>
                <select asp-for="Priority" asp-items="ViewBag.Priorities" class="form-select"></select>
            </div>
            <div class="col-md-6">
                <label asp-for="ExpectedValue" class="form-label">Expected Value (₹)</label>
                <input asp-for="ExpectedValue" class="form-control" type="number" min="0" step="0.01" />
                <span asp-validation-for="ExpectedValue" class="field-validation-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="AssignedTo" class="form-label">Assign To</label>
                <select asp-for="AssignedTo" asp-items="ViewBag.Users" class="form-select">
                    <option value="">— Unassigned —</option>
                </select>
            </div>
            <div class="col-12">
                <label asp-for="Notes" class="form-label">Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-crm px-4"><i class="bi bi-check-lg me-1"></i>Update</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
